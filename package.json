{
  "name": "playpulse",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "Backend-first intelligent sports club management system",
  "scripts": {
    "dev": "concurrently -k -n api,web \"npm:dev:api\" \"npm:dev:web\"",
    "dev:api": "tsx watch src/server.ts",
    "dev:web": "vite --config vite.config.ts",
    "frontend": "tsx src/server.ts",
    "start": "node dist/src/server.js",
    "build": "npm run build:api && npm run build:web",
    "build:api": "tsc -p tsconfig.json",
    "build:web": "vite build --config vite.config.ts",
    "check": "tsc -p tsconfig.json --noEmit && npm run check:web",
    "check:web": "tsc -p frontend/tsconfig.json --noEmit",
    "test": "npm run build:web && tsx --test test/project.test.ts test/database-integration.test.ts",
    "lint": "eslint src test --max-warnings=0",
    "migrate": "tsx src/database/migrate.ts",
    "migrate:deploy": "node dist/src/database/migrate.js",
    "security:audit": "npm audit --omit=dev",
    "quality": "npm run check && npm run lint && npm test && npm run build",
    "db:seed": "tsx scripts/seed-demo.ts",
    "db:backup": "node scripts/database-backup.mjs",
    "db:restore": "node scripts/database-restore.mjs"
  },
  "engines": {
    "node": ">=20"
  },
  "dependencies": {
    "bcryptjs": "^3.0.3",
    "cors": "^2.8.6",
    "dotenv": "^18.0.10",
    "express": "^5.3.0",
    "express-rate-limit": "^8.7.5",
    "helmet": "^8.3.0",
    "lucide-react": "^0.468.0",
    "jsonwebtoken": "^9.0.3",
    "jszip": "^3.10.2",
    "pdfkit": "^0.21.0",
    "pg": "^8.23.1",
    "pino": "^10.4.0",
    "react": "^19.0.0",
    "react-dom": "^19.0.0",
    "swagger-ui-express": "^5.0.1",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@types/react": "^19.0.0",
    "@types/react-dom": "^19.0.0",
    "@vitejs/plugin-react": "^4.3.4",
    "@eslint/js": "^10.0.1",
    "@types/bcryptjs": "^2.4.6",
    "@types/cors": "^2.8.19",
    "@types/express": "^5.0.6",
    "@types/jsonwebtoken": "^9.0.10",
    "@types/node": "^26.6.6",
    "@types/pdfkit": "^0.17.7",
    "@types/pg": "^8.23.1",
    "@types/supertest": "^7.2.1",
    "@types/swagger-ui-express": "^4.1.8",
    "eslint": "^10.15.0",
    "supertest": "^7.3.2",
    "tsx": "^4.23.15",
    "typescript": "^6.0.3",
    "typescript-eslint": "^8.73.0",
    "vite": "^6.0.7",
    "concurrently": "^9.1.0"
  }
}
